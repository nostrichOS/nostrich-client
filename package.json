{
  "name": "nostrich",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @nostrich/api db:generate",
    "db:push": "pnpm --filter @nostrich/api db:push",
    "db:migrate": "pnpm --filter @nostrich/api db:migrate"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.3"
  }
}
