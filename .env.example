# The public origin this instance is served from. Used for absolute links,
# social cards and NIP-98 origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3400

# Postgres. Only the trending snapshot table lives here.
DATABASE_URL=postgresql://nostrich:nostrich@localhost:5432/nostrich

# Where the trending worker gets its candidates. No default: with this unset
# the worker produces nothing rather than calling a service you did not choose.
# Any endpoint answering ?hours=<n>&limit=<n> with { data: [{ event_id, ... }] }.
TRENDING_INDEX_URL=

# Set to false to stop the trending worker building at all.
TRENDING_ENABLED=true

# Extra relays the worker reads from, comma separated. Defaults are used anyway.
WORKER_RELAYS=

# Where resized avatars are written. Any writable directory.
PFP_CACHE_DIR=/data/pfp

# Signs the image-proxy URLs so the proxy cannot be used as an open relay.
# Generate with: openssl rand -hex 32
UNFURL_PROXY_SECRET=

# Optional. A reader service that takes a URL appended to it and returns the page, used
# only for the few sites that refuse this server directly. Off unless you set it, because
# it sends those links to a third party.
UNFURL_READER_URL=

# Set to 1 for verbose worker logs.
LOG_DEBUG=0
